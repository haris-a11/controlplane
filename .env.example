# Copy to .env and fill in. .env is gitignored.

# Any provider LiteLLM supports. Pick one:
OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...        # note: exposes no logprobs; Tier 0 degrades

# Which model gets checked. The prefix tells LiteLLM the provider.
# The judge (Tier 2) uses the same model unless a caller overrides it.
CONTROLPLANE_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct
# CONTROLPLANE_MODEL=ollama/llama3.2  # local, free, no key needed
# CONTROLPLANE_MODEL=gpt-4o-mini

# Fallback pricing, used only when the provider publishes none that LiteLLM knows.
# Set these to your real contract rates so the overhead figures mean something —
# every cost is labelled "provider" or "estimated" according to which applied.
# CONTROLPLANE_USD_PER_PROMPT_TOKEN=0.0000002
# CONTROLPLANE_USD_PER_COMPLETION_TOKEN=0.0000006
